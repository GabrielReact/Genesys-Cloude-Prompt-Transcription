# Copie este arquivo para .env e preencha com as credenciais do seu OAuth Client.
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
# Host da API da sua regiao. Ex.: https://api.sae1.pure.cloud (Sao Paulo),
# https://api.mypurecloud.com (US East), https://api.mypurecloud.ie (EU West).
GENESYS_REGION_HOST=https://api.sae1.pure.cloud
